# Configure these in your hosting provider; Node does not load this file automatically.
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=https://your-roadguard-domain.example
# Set a private, randomly generated value. Never commit a real key or put it in frontend code.
SCRAPER_RUN_TOKEN=replace-with-a-long-random-private-key
# Point this at a writable persistent disk on the host.
SCRAPER_DATA_DIR=/app/data
SCRAPER_USER_AGENT=ROADGUARD-News/1.0 (your deployment contact)
